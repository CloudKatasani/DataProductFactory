# Data Product Factory — environment template.
# Copy to .env (gitignored). No secrets ever committed (Non-Negotiable #12).

# --- Database ---
# SQLite by default (zero-config, local-first). For multi-user Postgres, see
# docker-compose.yml and set:
#   DATABASE_URL="postgresql://dpf:dpf@localhost:5432/dpf?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Trust the local host in dev so Auth.js accepts http://localhost.
AUTH_TRUST_HOST="true"

# --- Workspace mirror root (Non-Negotiable #7) ---
# Where version-committed artifacts are mirrored. Defaults to ./workspace.
# DPF_WORKSPACE_ROOT="workspace"

# --- Optional LLM assist (propose-only, Non-Negotiable #3 & #6) ---
# The app is fully functional with NO key set. Assist degrades gracefully to
# manual authoring. Leave blank to disable AI assist entirely.
DPF_LLM_API_KEY=""
DPF_LLM_BASE_URL=""
DPF_LLM_MODEL=""
